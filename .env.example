# copy to .env (repo root, for Node) and python/.env (for Python), then fill in
DB_HOST=localhost
DB_PORT=5433
DB_NAME=ap_orchestara
DB_USER=postgres
DB_PASSWORD=change_me
REDIS_URL=redis://127.0.0.1:6379
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
# python/.env: llm for extraction + contract check, and rag embeddings — gemini or ollama
# (re-run rag.ingest after switching EMBED_PROVIDER)
GEMINI_API_KEY=your_gemini_key
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-flash-lite-latest
EMBED_PROVIDER=gemini
GEMINI_EMBED_MODEL=gemini-embedding-001
BANK_ACCOUNT_ID=3001
PORT=3000
